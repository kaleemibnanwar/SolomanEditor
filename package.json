{
  "name": "octo-cut",
  "version": "0.1.0",
  "description": "A non-destructive video editor that runs on your desktop",
  "homepage": "https://octocut.app",
  "desktopName": "octo-cut.desktop",
  "author": {
    "name": "kaleemibnanwar",
    "email": "kaleemibnanwar@gmail.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaleemibnanwar/octocut-source.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on http://localhost:8080 && node electron/launch.cjs . --dev\"",
    "electron:start": "pnpm build && node electron/launch.cjs .",
    "electron:build:dir": "pnpm build && electron-builder --dir",
    "electron:build": "pnpm build && electron-builder",
    "electron:build:linux": "pnpm build && electron-builder --linux deb --x64",
    "release": "pnpm build && electron-builder --publish always"
  },
